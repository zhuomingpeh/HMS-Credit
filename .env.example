# Postgres connection strings (Supabase project, ap-southeast-1) — app uses the pooled
# transaction-mode connection; CLI/migrations use the session-mode pooler (DIRECT_URL).
DATABASE_URL=
DIRECT_URL=

# Resend — leave unset in dev; lead submissions and admin notifications just log to console
RESEND_API_KEY=
EMAIL_FROM="HMS Credit <noreply@hmsmoney.com>"
ADMIN_NOTIFICATION_EMAIL=support@hmsmoney.com

# Singpass (Myinfo) — NOT registered yet. "Apply with Singpass" fails soft to the manual form
# until these are set. See README's Singpass section for what to do in the Developer Portal.
# SINGPASS_ENV=staging              # "staging" (default) or "production"
# SINGPASS_CLIENT_ID=               # from the SDP app's Basic Information tab
# SINGPASS_REDIRECT_URI=            # must exactly match what's registered; defaults to the
#                                    # current Vercel URL's /api/auth/singpass/callback
# SINGPASS_SIG_PRIVATE_JWK=         # from `node scripts/generate-singpass-keys.mjs` (already run
# SINGPASS_ENC_PRIVATE_JWK=         # once — public halves are committed in src/lib/singpass/jwks.ts;
#                                    # get the private values from whoever ran the script, or re-run
#                                    # it and update jwks.ts too if starting fresh)
